# --- RSVP storage (required in production) ---
# On Vercel: Storage → Marketplace → "Upstash for Redis" → Connect to this project.
# Vercel injects these automatically. Locally, RSVPs are saved to .data/rsvps.json instead.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Guest list dashboard at /admin ---
ADMIN_PASSWORD=change-me-to-something-long

# --- Optional: your production URL (used for share previews) ---
NEXT_PUBLIC_SITE_URL=https://your-wedding.vercel.app
